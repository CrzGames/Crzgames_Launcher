{
  "name": "@crzgames/launcher",
  "version": "1.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "web:run:develop": "nuxi dev --dotenv .env.development --no-clear --port=3555",
    "web:run:staging": "nuxi dev --dotenv .env.staging --no-clear --port=3555",
    "web:run:prod": "nuxi dev --dotenv .env.production --no-clear --port=3555",
    "web:build:static:develop": "nuxi generate --dotenv .env.development",
    "web:build:static:staging": "nuxi generate --dotenv .env.staging",
    "web:build:static:prod": "nuxi generate --dotenv .env.production",
    "web:analyze": "nuxi analyze --loglevel verbose",
    "web:cleanup": "nuxi cleanup",
    "web:prepare": "nuxi prepare",
    "desktop:run:dev": "cross-env RUST_BACKTRACE=full tauri dev",
    "desktop:check:compile": "cd src-tauri && cargo check",
    "desktop:build:windows:x64": "tauri build --target x86_64-pc-windows-msvc",
    "desktop:build:windows:arm64": "tauri build --target aarch64-pc-windows-msvc",
    "desktop:build:macos:arm64": "tauri build --target aarch64-apple-darwin",
    "desktop:build:linux:x86_64": "tauri build --target x86_64-unknown-linux-gnu",
    "desktop:build:linux:arm64": "tauri build --target aarch64-unknown-linux-gnu",
    "desktop:install:target:windows": "rustup target add x86_64-pc-windows-msvc && rustup target add aarch64-pc-windows-msvc",
    "desktop:install:target:macos": "rustup target add aarch64-apple-darwin",
    "desktop:install:target:linux": "rustup target add x86_64-unknown-linux-gnu && rustup target add aarch64-unknown-linux-gnu",
    "test:unit:dev": "vitest watch --coverage",
    "test:unit:dev:gui": "vitest watch --ui --coverage",
    "test:unit:staging-prod": "vitest run --coverage",
    "lint": "npm run lint:prettier && npm run lint:eslint && npm run lint:ts",
    "lint:prettier": "prettier --check .",
    "lint:ts": "vue-tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "tauri": "tauri",
    "prepare": "husky && nuxi prepare"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "@vee-validate/rules": "^4.15.1",
    "axios": "^1.13.6",
    "floating-vue": "^5.2.2",
    "js-base64": "^3.7.8",
    "luxon": "^3.7.2",
    "notyf": "^3.10.0",
    "pinia": "^3.0.4",
    "swiper": "^12.1.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/test-utils": "^4.0.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tauri-apps/cli": "^2.10.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jsdom": "^28.0.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/ui": "4.1.1",
    "@vitest/coverage-v8": "4.1.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "init": "^0.1.2",
    "jsdom": "^29.0.1",
    "json": "^11.0.0",
    "nitropack": "^2.13.2",
    "npm-check-updates": "^19.6.5",
    "npx": "^10.2.2",
    "nuxt": "^4.4.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sass": "^1.98.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
